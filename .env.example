# ─────────────────────────────────────────────────────────────
# 1~3주차에는 아무것도 필요 없다. 목업 데이터로만 돌아간다.
# 4주차에 Supabase를 붙일 때 이 파일을 .env.local 로 복사해서 채운다.
# ─────────────────────────────────────────────────────────────

# Supabase 프로젝트 → Settings → Database → Connection string (URI)
# DATABASE_URL="postgresql://postgres.xxxx:비밀번호@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.xxxx:비밀번호@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# 관리자 패널 비밀번호 (MVP에서는 로그인 대신 이거 하나로 막는다)
# ADMIN_PASSWORD="spot2026"

# 센서 게이트웨이가 /api/detect 를 호출할 때 쓰는 키
# DETECT_API_KEY="dev-detect-key"
